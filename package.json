{
  "name": "bastion-cli",
  "version": "1.0.0",
  "description": "A local-first, terminal-based password security auditor and generator adhering to NIST SP 800-63B and OWASP guidelines.",
  "keywords": [
    "password",
    "security",
    "nist",
    "owasp",
    "cli",
    "audit",
    "generator",
    "zxcvbn",
    "breach"
  ],
  "author": "Bastion Security Team",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bastion": "dist/cli.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "vite build",
    "start": "node dist/cli.js",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "preuninstall": "node dist/cli.js uninstall"
  },
  "dependencies": {
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publint": {
    "strict": true
  }
}
